# ==============================================================================
# OneSol Invoice Manager — Docker Environment Configuration
# ==============================================================================

# Application Port
APP_PORT=8080

# MySQL Database Credentials
DB_HOST=db
DB_PORT=3306
DB_NAME=onesol_invoices
DB_USER=onesol
DB_PASS=onesol_secret
DB_ROOT_PASS=root_secret
DB_EXTERNAL_PORT=3307

# Redis Cache Credentials
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_EXTERNAL_PORT=6380

# Environment Mode
APP_ENV=production
